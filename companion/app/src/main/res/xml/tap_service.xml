<?xml version="1.0" encoding="utf-8"?>
<!-- Scoped to Android Auto's package alone: android:packageNames restricts
     which apps' windows this service can even see. It cannot read or click
     any other app. That scoping is the app's core privacy property.
     flagRetrieveInteractiveWindows lets it read Android Auto's overflow popup,
     which is often a separate window from the settings screen; TapService
     skips every window whose root is not Android Auto's. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="50"
    android:packageNames="com.google.android.projection.gearhead"
    android:description="@string/acc_desc"/>
